{
  "name": "the-handy-man",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:backend": "bun run --filter @handy-man/backend dev",
    "dev:web": "bun run --filter @handy-man/web dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "test:unit": "bun run --filter @handy-man/backend test",
    "test:api": "bunx playwright test --project=api",
    "test:e2e": "bunx playwright test --project=e2e-chromium",
    "test:e2e:mobile": "bunx playwright test --project=e2e-mobile",
    "test:playwright": "bunx playwright test",
    "test:report": "bunx playwright show-report tests/reports/playwright-report",
    "lint": "eslint .",
    "db:generate": "bunx prisma generate",
    "db:push": "bunx prisma db push",
    "db:migrate": "bunx prisma migrate dev",
    "db:studio": "bunx prisma studio",
    "db:seed": "bunx prisma db seed"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bun": "latest",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
