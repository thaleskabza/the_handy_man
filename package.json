{
  "name": "the-handy-man",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:backend": "bun run --filter @handy-man/backend dev",
    "dev:web": "bun run --filter @handy-man/web dev",
    "build": "bun run --filter '*' build",
    "test": "vitest",
    "lint": "eslint .",
    "db:generate": "bunx prisma generate",
    "db:push": "bunx prisma db push",
    "db:migrate": "bunx prisma migrate dev",
    "db:studio": "bunx prisma studio"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
